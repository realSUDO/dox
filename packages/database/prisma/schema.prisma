generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  displayName  String?  @db.VarChar(100)
  role         String   @default("user") @db.VarChar(20)
  // role: "user" | "admin"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tokenBalance Int      @default(50000) @map("token_balance")

  sessions        Session[]
  ownedLeafs      Leaf[]
  leafMembers     LeafMember[]
  guardrailEvents GuardrailEvent[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  // token stored as SHA-256 hash of the raw cookie value
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Leaf {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String   @db.VarChar(200)
  description String?
  status      String   @default("active") @db.VarChar(20)
  // status: "active" | "archived"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner           User             @relation(fields: [ownerId], references: [id])
  members         LeafMember[]
  sources         Source[]
  chatSessions    ChatSession[]
  guardrailEvents GuardrailEvent[]

  @@index([ownerId])
  @@map("leafs")
}

model LeafMember {
  leafId   String   @map("leaf_id")
  userId   String   @map("user_id")
  role     String   @default("viewer") @db.VarChar(20)
  // role: "viewer" | "editor" | "owner"
  joinedAt DateTime @default(now()) @map("joined_at")

  leaf Leaf @relation(fields: [leafId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([leafId, userId])
  @@map("leaf_members")
}

model Source {
  id         String @id @default(uuid())
  leafId     String @map("leaf_id")
  uploadedBy String @map("uploaded_by")

  type String @db.VarChar(10)
  // type: "file" | "link" | "text"

  fileName      String? @map("file_name") @db.VarChar(500)
  mimeType      String? @map("mime_type") @db.VarChar(100)
  fileSizeBytes BigInt? @map("file_size_bytes")
  storageKey    String? @map("storage_key")

  sourceUrl   String? @map("source_url")
  textContent String? @map("text_content")

  status String @default("pending_upload") @db.VarChar(30)
  // status: "pending_upload" | "queued" | "processing" | "embedding" | "indexed" | "reindex_queued" | "failed"

  chunkCount   Int?      @map("chunk_count")
  metadata     Json?
  indexedAt    DateTime? @map("indexed_at")
  indexVersion Int       @default(1) @map("index_version")
  lastError    String?   @map("last_error")

  zipSummary     String? @map("zip_summary")
  zipApproved    Boolean? @map("zip_approved")
  zipFailedFiles Json?    @map("zip_failed_files")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  leaf          Leaf           @relation(fields: [leafId], references: [id], onDelete: Cascade)
  chunks        Chunk[]
  ingestionJobs IngestionJob[]

  @@index([leafId])
  @@index([status])
  @@index([leafId, deletedAt])
  @@map("sources")
}

model Chunk {
  id           String @id @default(uuid())
  sourceId     String @map("source_id")
  leafId       String @map("leaf_id")
  indexVersion Int    @default(1) @map("index_version")
  chunkIndex   Int    @map("chunk_index")

  content    String
  contentTsv Unsupported("tsvector")? @map("content_tsv")
  // contentTsv is a generated column managed via raw migration
  // Added manually in migration

  pageNumber     Int?    @map("page_number")
  startSeconds   Float?  @map("start_seconds")
  endSeconds     Float?  @map("end_seconds")
  timestampLabel String? @map("timestamp_label") @db.VarChar(30)

  qdrantPointId String @map("qdrant_point_id")

  subFileName String? @map("sub_file_name") @db.VarChar(500)

  status String @default("pending") @db.VarChar(20)
  // status: "pending" | "indexed" | "deleted"

  createdAt DateTime @default(now()) @map("created_at")

  source    Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@index([sourceId])
  @@index([leafId])
  @@index([qdrantPointId])
  @@map("chunks")
}

model ChatSession {
  id        String   @id @default(uuid())
  leafId    String   @map("leaf_id")
  userId    String   @map("user_id")
  title     String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leaf     Leaf          @relation(fields: [leafId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id               String   @id @default(uuid())
  chatSessionId    String   @map("chat_session_id")
  role             String   @db.VarChar(15)
  // role: "user" | "assistant" | "system"
  content          String
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  thoughtProcess   Json?    @map("thought_process")
  createdAt        DateTime @default(now()) @map("created_at")

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  citations   Citation[]

  @@index([chatSessionId])
  @@map("chat_messages")
}

model Citation {
  id           String   @id @default(uuid())
  messageId    String   @map("message_id")
  chunkId      String   @map("chunk_id")
  sourceId     String   @map("source_id")
  index        Int      @default(1)
  score        Float?
  displayLabel String?  @map("display_label") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk   Chunk       @relation(fields: [chunkId], references: [id])

  @@index([messageId])
  @@map("citations")
}

model GuardrailEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  leafId    String?  @map("leaf_id")
  stage     String   @db.VarChar(20)
  // stage: "input" | "output"
  rule      String   @db.VarChar(100)
  // rule: "prompt_injection" | "pii" | "unsafe_content" | "policy" | "ungrounded" | "unsafe_output"
  action    String   @db.VarChar(20)
  // action: "blocked" | "redacted" | "flagged"
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])
  leaf Leaf? @relation(fields: [leafId], references: [id])

  @@index([userId])
  @@index([leafId])
  @@index([createdAt])
  @@map("guardrail_events")
}

model IngestionJob {
  id           String    @id @default(uuid())
  sourceId     String    @map("source_id")
  bullJobId    String?   @map("bull_job_id") @db.VarChar(100)
  jobType      String    @map("job_type") @db.VarChar(30)
  // jobType: "ingest" | "embed" | "delete_vectors" | "reindex"
  status       String    @default("queued") @db.VarChar(20)
  // status: "queued" | "active" | "completed" | "failed" | "delayed"
  attempts     Int       @default(0)
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("ingestion_jobs")
}
