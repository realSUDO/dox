# Postgres
POSTGRES_USER=ragapp
POSTGRES_PASSWORD=<strong-random>
POSTGRES_DB=ragapp
DATABASE_URL=postgresql://ragapp:<password>@postgres:5432/ragapp

# Valkey
VALKEY_PASSWORD=<strong-random>
VALKEY_URL=redis://:<password>@valkey:6379

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=<strong-random>

# DigitalOcean Spaces
DO_SPACES_ENDPOINT=https://<region>.digitaloceanspaces.com
DO_SPACES_BUCKET=<bucket-name>
DO_SPACES_ACCESS_KEY=<key>
DO_SPACES_SECRET_KEY=<secret>
DO_SPACES_REGION=<region>

# OpenAI
OPENAI_API_KEY=sk-...

# App
NODE_ENV=prod
BASE_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
PORT=8000

# Session
SESSION_SECRET=<64-byte-random-hex>

# Optional
LOGGER_LEVEL=info
EMBED_BATCH_SIZE=100
GENERATION_MODEL=gpt-4o-mini
QUERY_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
RERANKER=local
