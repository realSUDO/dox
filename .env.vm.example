# Docker Image Name (lowercase github repository name)
# This is used by docker-compose to pull from GHCR
IMAGE_NAME=realsudo/dox

# Domain Name for Caddy Auto-TLS
DOMAIN=doxx.sud-o.app

# Frontend Next.js API URL (used by browser to reach backend)
# This maps perfectly to the Caddy reverse_proxy routes (e.g. /trpc, /admin/queues)
NEXT_PUBLIC_API_URL=https://doxx.sud-o.app

# Postgres
POSTGRES_USER=dox
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=dox
# Notice we use the docker-compose service name "postgres" as the host
DATABASE_URL=postgresql://dox:generate_a_secure_password_here@postgres:5432/dox

# Valkey (Redis)
VALKEY_PASSWORD=generate_a_secure_password_here
# Notice we use the docker-compose service name "valkey" as the host
VALKEY_URL=redis://:generate_a_secure_password_here@valkey:6379

# Qdrant
# Notice we use the docker-compose service name "qdrant" as the host
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=generate_a_secure_api_key_here

# S3 / DigitalOcean Spaces
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=your_bucket_name
SPACES_KEY=your_access_key
SPACES_SECRET=your_secret_key

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key
